server {
    listen $PORT default_server;
    server_name _;

    # 프론트 SPA 정적 서빙
    root /usr/share/nginx/html;
    index index.html;

    # 해시 정적 자산(JS/CSS): 존재 파일만 서빙, SPA fallback 금지
    location ^~ /assets/ {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html은 캐시 고정 방지(신규 배포 시 구 chunk 참조 방지)
    location = /index.html {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # / 는 index.html
    location = / {
        try_files /index.html =404;
    }

    # 나머지는 SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SSE: /api/realtime/.../stream 공통 처리
    location ~ ^/api/realtime/.+/stream$ {
        # 최소 보안: SSE 구독은 GET만 허용
        limit_except GET {
            deny all;
        }

        proxy_pass $BACKEND_BASE_URL;

        proxy_http_version 1.1;
        proxy_set_header    Connection          "";
        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;

        proxy_buffering     off;
        proxy_cache         off;
        gzip                off;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        add_header          X-Accel-Buffering no always;
    }

    # Presigned 업로드: /storage/<bucket>/<key>?signature...
    location /storage/ {
        # /storage 접두어를 제거해 실제 오브젝트 스토리지 경로로 전달
        rewrite ^/storage/(.*)$ /$1 break;

        proxy_pass $OBJECT_STORAGE_BASE_URL;

        proxy_http_version 1.1;
        proxy_set_header    Connection          "";
        # Presigned URL 서명 검증을 위해 Host는 업스트림 스토리지 호스트를 사용한다.
        proxy_set_header    Host                $proxy_host;
        # 객체 스토리지에는 Bearer/Cookie 인증 헤더를 전달하지 않는다.
        proxy_set_header    Authorization       "";
        proxy_set_header    Cookie              "";
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;

        # 최소 보안: 허용 메서드 제한
        limit_except PUT GET HEAD OPTIONS {
            deny all;
        }

        # 업로드 본문 크기 제한(백엔드 50MB 정책 + 여유)
        client_max_body_size 55m;
    }

    # 일반 API, Spring Boot로 프록시 (경로 /api 유지)
    location /api/ {
        # proxy_pass의 값은 환경변수 $BACKEND_BASE_URL로 대체됩니다.
        proxy_pass $BACKEND_BASE_URL;

        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;
    }
}
