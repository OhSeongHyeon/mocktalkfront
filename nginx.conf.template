server {
    listen $PORT default_server;
    server_name _;

    # 프론트 SPA 정적 서빙
    root /usr/share/nginx/html;
    index index.html;

    # 해시 정적 자산(JS/CSS): 존재 파일만 서빙, SPA fallback 금지
    location ^~ /assets/ {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html은 캐시 고정 방지(신규 배포 시 구 chunk 참조 방지)
    location = /index.html {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # / 는 index.html
    location = / {
        try_files /index.html =404;
    }

    # 나머지는 SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SSE: /api/realtime/.../stream 공통 처리
    location ~ ^/api/realtime/.+/stream$ {
        # 최소 보안: SSE 구독은 GET만 허용
        limit_except GET {
            deny all;
        }

        proxy_pass $BACKEND_BASE_URL;

        proxy_http_version 1.1;
        proxy_set_header    Connection          "";
        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;

        proxy_buffering     off;
        proxy_cache         off;
        gzip                off;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        add_header          X-Accel-Buffering no always;
    }

    # 일반 API, Spring Boot로 프록시 (경로 /api 유지)
    location /api/ {
        # proxy_pass의 값은 환경변수 $BACKEND_BASE_URL로 대체됩니다.
        proxy_pass $BACKEND_BASE_URL;

        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $http_x_forwarded_proto;
    }
}
